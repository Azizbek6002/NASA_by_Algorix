# ---------------------------------------------------------------------------
# SPACE ARCHIVE — environment configuration
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: AI assistant (OpenAI-compatible endpoint).
# The UI works without these. /api/v1/ai/ask returns a clear 503 when unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Optional: provider credentials for the future full-stack dataset builder.
# The Vercel demo uses bundled CelesTrak / NASA / JPL snapshots and needs none.
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=
DISCOS_TOKEN=

# Optional: server-side refresh of CelesTrak GP data (defaults to bundled snapshot)
CELESTRAK_REFRESH_ENABLED=false
